---
/**
 * Noga (YAUYA): position: sticky; bottom: 0; z-index: 0 — stoji ZA vsebino
 * in se razkrije, ko zadnja sekcija (zaobljeni vogali) odpelje navzgor.
 * Ogromen wordmark čez celo širino + 3 stolpci + spodnja vrstica.
 * Skrita podrobnost: ko je noga povsem razkrita, pika »oživi«.
 */
import { FULL_PATH, NAV, SITE } from '../data/site';
import { wmKern } from '../data/wordmark';
import Icon from './ui/Icon.astro';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const href = (id: string) => (home ? `#${id}` : `${FULL_PATH}#${id}`);
const year = new Date().getFullYear();
// Wordmark kot v heroju: vsaka črka svoj element z optičnim kerningom para
const wmChars = [...'Site Craft Studio.'].map((ch, i, all) => ({ ch, k: wmKern(ch, all[i + 1]) }));
---

<footer class="footer" data-footer>
  <div class="footer__inner">
    <p class="footer__wm" aria-hidden="true">
      {
        wmChars.map(({ ch, k }) =>
          ch === ' ' ? (
            <span>{' '}</span>
          ) : (
            <span class:list={['footer__ch', ch === '.' && 'footer__dot']} style={`--k:${k}em`}>
              {ch}
            </span>
          ),
        )
      }
    </p>

    <div class="footer__cols">
      <div class="footer__col">
        <a href={SITE.phoneHref}><Icon name="phone" /> {SITE.phone}</a>
        <a href={SITE.emailHref}><Icon name="mail" /> {SITE.email}</a>
      </div>

      <div class="footer__col footer__col--center">
        <span>Izdelava spletnih strani</span>
        <span>Slovenija · sitecraftstudio.si</span>
      </div>

      <nav class="footer__col footer__col--right" aria-label="Noga">
        {NAV.map((item) => <a href={href(item.id)}>{item.label}</a>)}
        <a href="/politika-zasebnosti/">Politika zasebnosti</a>
        <a href={home ? '#top' : '/'} class="footer__top">Na vrh <Icon name="arrow-up" /></a>
      </nav>
    </div>

    <div class="footer__bottom" data-footer-end>
      <p>© {year} {SITE.name} · {SITE.owner}. Vse pravice pridržane.</p>
      <p class="footer__end">
        <span>Prišli ste do konca strani. Naslednji korak je preprost — </span><a href={SITE.phoneHref}
          >pokličite</a
        >.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: sticky;
    bottom: 0;
    z-index: 0;
    background: var(--accent);
    color: var(--on-accent);
  }

  .footer__inner {
    container-type: inline-size;
    padding: clamp(20px, 2.4vw, 32px) var(--gutter) clamp(18px, 2vw, 28px);
  }

  /* Flex: prazni znaki iz markupa med črkami se ne izrišejo (natančna širina) */
  .footer__wm {
    display: flex;
    font-family: var(--font-display);
    font-size: calc(100cqw / var(--wm-ratio));
    line-height: 0.86;
    /* Razmik je na .footer__ch (--wm-track + optični kerning para), ne v letter-spacing */
    letter-spacing: 0;
    white-space: nowrap;
    color: var(--on-accent);
  }

  .footer__ch {
    margin-inline-end: calc(var(--wm-track) + var(--k, 0em));
  }

  .footer__dot {
    display: inline-block;
    color: var(--ink);
    transform-origin: 50% 85%;
  }

  .footer:global(.is-done) .footer__dot {
    animation: dot-pop 1.1s var(--ease-out) both;
  }

  @keyframes dot-pop {
    0% {
      transform: none;
    }
    35% {
      transform: translateY(-0.18em) scale(1.35);
    }
    60% {
      transform: translateY(0) scale(0.92);
    }
    100% {
      transform: none;
    }
  }

  .footer__cols {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: 20px;
    border-top: 1px solid rgba(var(--white-rgb), 0.28);
    font-size: var(--fs-small);
  }

  .footer__col {
    display: grid;
    align-content: start;
    gap: 2px;
  }

  .footer__col a,
  .footer__col span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    color: var(--on-accent-2);
    transition: color 0.25s var(--ease-out);
  }

  .footer__col a:hover {
    color: var(--on-accent);
  }

  .footer__col a:focus-visible {
    outline: 2px solid var(--on-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .footer__col--center {
    justify-items: center;
    text-align: center;
  }

  .footer__col--right {
    justify-items: end;
    grid-template-columns: repeat(2, auto);
    justify-content: end;
    column-gap: 24px;
  }

  .footer__top :global(.icon) {
    transition: transform 0.4s var(--ease-out);
  }

  .footer__top:hover :global(.icon) {
    transform: translateY(-3px);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(20px, 2.4vw, 32px);
    font: 500 var(--fs-label) / 1.5 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--on-accent-2);
  }

  .footer__end {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.8s var(--ease-out) 0.4s,
      transform 0.8s var(--ease-out) 0.4s;
  }

  .footer:global(.is-done) .footer__end {
    opacity: 1;
    transform: none;
  }

  .footer__end a {
    color: var(--on-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 760px) {
    .footer__cols {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .footer__col--center,
    .footer__col--right {
      justify-items: start;
      text-align: left;
      justify-content: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__end {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Noga je sticky za vsebino (IntersectionObserver jo vidi ves čas), zato
  // razkritje zaznamo po položaju drsenja: ko smo na samem dnu strani,
  // pika »oživi« in pojavi se sporočilo.
  const footer = document.querySelector<HTMLElement>('[data-footer]');
  if (footer) {
    let raf = 0;
    const check = () => {
      raf = 0;
      const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
      if (atBottom) {
        footer.classList.add('is-done');
        window.removeEventListener('scroll', onScroll);
      }
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(check);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
