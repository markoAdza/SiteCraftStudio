---
/**
 * Kontakt — ima vlogo YAUYA »map-home« sekcije: zadnja sekcija pred nogo,
 * z zaobljenimi spodnjimi vogali, ki odpelje navzgor in razkrije nogo.
 * Obrazec pošilja na Cloudflare Pages Function /api/contact (Resend + Turnstile).
 */
import { SITE } from '../data/site';
import { PLAN_OPTIONS } from '../data/pricing';
import Icon from './ui/Icon.astro';
import Button from './ui/Button.astro';

// Turnstile testni ključ (vedno uspe) za lokalni razvoj; v produkciji nastavi PUBLIC_TURNSTILE_SITE_KEY.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<section class="contact" id="kontakt" aria-labelledby="kontakt-title">
  <div class="container contact__grid">
    <div class="contact__info">
      <p class="eyebrow"><b>(07)</b> Kontakt</p>
      <h2 class="h2" id="kontakt-title" data-float>Začnimo vašo <em>novo</em> spletno stran.</h2>
      <p class="lead" data-reveal>
        Pokličite ali mi pišite. Skupaj pregledava, kaj vaše podjetje potrebuje, in pripravim predlog.
      </p>

      <a class="contact__phone" href={SITE.phoneHref} data-reveal>
        <span class="contact__phone-label">Pokličite</span>
        <span class="contact__phone-num">{SITE.phone}</span>
      </a>

      <ul class="contact__list" data-reveal>
        <li>
          <a href={SITE.emailHref}><Icon name="mail" /> {SITE.email}</a>
        </li>
        <li><Icon name="map-pin" /> Za podjetja po vsej Sloveniji</li>
        <li><Icon name="clock" /> Spletna stran v enem tednu</li>
      </ul>
    </div>

    <form class="form" action="/api/contact" method="post" novalidate data-contact-form data-reveal>
      <div class="form__row">
        <div class="field">
          <label class="field__label" for="contact-name">Ime in priimek</label>
          <input
            class="field__input"
            id="contact-name"
            name="ime"
            type="text"
            autocomplete="name"
            required
            minlength="2"
            maxlength="100"
            aria-describedby="contact-name-err"
          />
          <p class="field__error" id="contact-name-err" data-error-for="ime"></p>
        </div>
        <div class="field">
          <label class="field__label" for="contact-email">E-pošta</label>
          <input
            class="field__input"
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            maxlength="200"
            aria-describedby="contact-email-err"
          />
          <p class="field__error" id="contact-email-err" data-error-for="email"></p>
        </div>
      </div>

      <div class="form__row">
        <div class="field">
          <label class="field__label" for="contact-phone">Telefon <span>(neobvezno)</span></label>
          <input
            class="field__input"
            id="contact-phone"
            name="telefon"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            maxlength="40"
          />
        </div>
        <div class="field">
          <label class="field__label" for="contact-plan">Paket</label>
          <div class="field__select">
            <select class="field__input" id="contact-plan" name="paket">
              {PLAN_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
            <Icon name="arrow-down" />
          </div>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="contact-message">Sporočilo</label>
        <textarea
          class="field__input field__textarea"
          id="contact-message"
          name="sporocilo"
          rows="5"
          required
          minlength="10"
          maxlength="5000"
          placeholder="Na kratko opišite svoje podjetje in kaj potrebujete …"
          aria-describedby="contact-message-err"></textarea>
        <p class="field__error" id="contact-message-err" data-error-for="sporocilo"></p>
      </div>

      <!-- Past za bote: ljudje tega polja ne vidijo -->
      <div class="form__trap" aria-hidden="true">
        <label for="contact-website">Spletna stran</label>
        <input id="contact-website" name="spletna_stran" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field field--check">
        <input class="check" id="contact-consent" name="soglasje" type="checkbox" required aria-describedby="contact-consent-err" />
        <label for="contact-consent">
          Strinjam se, da se moji podatki uporabijo za odgovor na to povpraševanje. Več v
          <a class="link" href="/politika-zasebnosti/">politiki zasebnosti</a>.
        </label>
        <p class="field__error" id="contact-consent-err" data-error-for="soglasje"></p>
      </div>

      <div class="form__turnstile" data-turnstile data-sitekey={siteKey}></div>

      <div class="form__foot">
        <Button type="submit" label="Pošlji sporočilo" icon="send" size="lg" magnet data-submit />
        <p class="form__status" role="status" aria-live="polite" data-status></p>
      </div>

      <noscript>
        <p class="form__noscript">
          Za pošiljanje obrazca potrebujete JavaScript. Lahko pa pokličete na {SITE.phone} ali pišete na {SITE.email}.
        </p>
      </noscript>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    z-index: 1;
    padding-block: var(--section-y);
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    box-shadow: 0 40px 80px rgba(var(--black-rgb), 0.45);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(40px, 6vw, 112px);
    align-items: start;
  }

  .contact__info {
    display: grid;
    gap: 24px;
  }

  .contact__phone {
    display: grid;
    gap: 6px;
    margin-top: 12px;
    padding: 20px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .contact__phone-label {
    font: 500 var(--fs-label) / 1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .contact__phone-num {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.4vw, 4rem);
    line-height: 1;
    letter-spacing: -0.01em;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition:
      background-size 0.6s var(--ease-out),
      color 0.3s var(--ease-out);
    justify-self: start;
  }

  .contact__phone:hover .contact__phone-num,
  .contact__phone:focus-visible .contact__phone-num {
    color: var(--accent-ink);
    background-size: 100% 1px;
  }

  .contact__list {
    display: grid;
    gap: 12px;
    color: var(--text-secondary);
  }

  .contact__list li,
  .contact__list a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .contact__list a {
    min-height: 44px;
    transition: color 0.25s var(--ease-out);
  }

  .contact__list a:hover {
    color: var(--text);
  }

  .contact__list :global(.icon) {
    color: var(--accent-ink);
  }

  /* ================================================================ Obrazec */
  .form {
    display: grid;
    gap: 18px;
    padding: clamp(20px, 3vw, 40px);
    border-radius: var(--r-md);
    border: 1px solid var(--border);
    background: var(--bg);
  }

  .form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .field {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .field__label {
    font: 500 var(--fs-label) / 1.3 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .field__label span {
    text-transform: none;
    letter-spacing: 0;
  }

  .field__input {
    width: 100%;
    min-height: 50px;
    padding: 12px 14px;
    border-radius: var(--r-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: 400 1rem / 1.4 var(--font-sans);
    transition:
      border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out);
    appearance: none;
  }

  .field__input::placeholder {
    color: var(--text-tertiary);
  }

  .field__input:hover {
    border-color: var(--border-hover);
  }

  .field__input:focus {
    outline: none;
    border-color: var(--accent-ink);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.35);
  }

  .field__input[aria-invalid='true'] {
    border-color: var(--error);
  }

  .field__input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .field__textarea {
    min-height: 140px;
    resize: vertical;
  }

  .field__select {
    position: relative;
  }

  .field__select select {
    padding-right: 40px;
    cursor: pointer;
  }

  .field__select :global(.icon) {
    position: absolute;
    right: 14px;
    top: 50%;
    translate: 0 -50%;
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .field__error {
    min-height: 0;
    font-size: 0.8125rem;
    color: var(--error);
  }

  .field__error:empty {
    display: none;
  }

  .field--check {
    grid-template-columns: 22px 1fr;
    gap: 6px 12px;
    align-items: start;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .field--check .field__error {
    grid-column: 2;
  }

  .check {
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: var(--r-xs);
    border: 1px solid var(--border-hover);
    background: var(--surface);
    appearance: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition:
      background-color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }

  .check::after {
    content: '';
    width: 10px;
    height: 6px;
    border-left: 2px solid var(--on-accent);
    border-bottom: 2px solid var(--on-accent);
    transform: rotate(-45deg) translate(1px, -1px) scale(0);
    transition: transform 0.2s var(--ease-out);
  }

  .check:checked {
    background: var(--accent);
    border-color: var(--accent);
  }

  .check:checked::after {
    transform: rotate(-45deg) translate(1px, -1px) scale(1);
  }

  .check:hover {
    border-color: var(--accent-ink);
  }

  .check:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 3px;
  }

  .check[aria-invalid='true'] {
    border-color: var(--error);
  }

  .form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__turnstile {
    min-height: 65px;
  }

  .form__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .form__status {
    flex: 1 1 220px;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .form__status:global(.is-success) {
    color: var(--success);
  }

  .form__status:global(.is-error) {
    color: var(--error);
  }

  .form__noscript {
    color: var(--warning);
  }

  .form :global(button[data-submit][aria-busy='true']) {
    opacity: 0.7;
    pointer-events: none;
  }

  @media (max-width: 1024px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .form__row {
      grid-template-columns: minmax(0, 1fr);
    }

    .form :global(button[data-submit]) {
      width: 100%;
    }
  }
</style>

<script>
  import { initContactForm } from '../scripts/contact-form';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) initContactForm(form);
</script>
