---
/** Uvod kratke predstavitve: kdo sem, kaj delam, takojšen kontakt. */
import { SITE } from '../../data/site';
import Button from '../ui/Button.astro';
---

<section class="mintro" aria-labelledby="mintro-title">
  <div class="mini-wrap">
    <p class="eyebrow"><b>●</b> Izdelava spletnih strani</p>
    <h1 class="mintro__title" id="mintro-title">
      Za vse poskrbim jaz, vi se posvetite <em>svojemu poslu.</em>
    </h1>
    <p class="lead mintro__lead">
      Oblikujem, razvijem in vzdržujem spletne strani za podjetja - od prve ideje do objave, gostovanja in kasnejših
      sprememb. Stran je pripravljena v enem tednu.
    </p>
    <div class="mintro__cta">
      <Button href={SITE.phoneHref} label={`Pokličite ${SITE.phone}`} iconLeft="phone" size="lg" />
      <Button href="#cenik" label="Poglejte cenik" icon="arrow-down" size="lg" variant="ghost" />
    </div>
  </div>
</section>

<style>
  .mintro {
    padding-block: clamp(56px, 10vw, 120px) clamp(48px, 7vw, 88px);
  }

  .mintro__title {
    margin-top: 20px;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .mintro__title em {
    font-style: italic;
    color: var(--accent-ink);
  }

  .mintro__lead {
    margin-top: 24px;
  }

  .mintro__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @media (max-width: 480px) {
    .mintro__cta :global(.btn) {
      width: 100%;
    }
  }
</style>
