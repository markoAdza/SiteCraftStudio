---
/** Glava kratke predstavitve: logotip, stikalo teme in preklop na celotno podobo. */
import { FULL_PATH } from '../../data/site';
import Icon from '../ui/Icon.astro';
import ThemeToggle from '../ThemeToggle.astro';
---

<header class="mhead">
  <div class="mini-wrap mhead__bar">
    <a class="mhead__logo" href="/" aria-label="Site Craft Studio — na vrh">
      Site Craft Studio<span class="mhead__dot">.</span>
    </a>
    <div class="mhead__right">
      <ThemeToggle />
      <a class="mhead__full" href={FULL_PATH} data-view="full">
        <span>Celotna stran</span>
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</header>

<style>
  .mhead {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(var(--bg-rgb), 0.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .mhead__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 64px;
  }

  .mhead__logo {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .mhead__dot {
    color: var(--accent-ink);
  }

  .mhead__right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mhead__full {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    border: 1px solid var(--border-hover);
    font: 500 0.75rem / 1 var(--font-sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
    transition:
      color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out);
  }

  .mhead__full:hover {
    color: var(--text);
    border-color: var(--text-tertiary);
  }

  @media (max-width: 380px) {
    .mhead__full {
      padding: 0 10px;
    }
  }
</style>
