---
/**
 * Fast Food Lan — vrteči se pečat (kot na fast-food-lan.vercel.app):
 * SVG <textPath> obroč se vrti (26 s, linearno), logotip v sredini miruje.
 */
import { Image } from 'astro:assets';
import logo from '../../assets/work/lan-logo.png';

const ring = 'KEBAB • JUFKA • BURGER • PIZZA • ŽAR • POMMES • ';
---

<div class="lan" aria-hidden="true">
  <p class="lan__kicker">Hrastnik <i></i> Zasavje</p>

  <div class="lan__seal">
    <svg class="lan__ring" viewBox="0 0 240 240">
      <defs>
        <path id="lan-ring-path" d="M120,120 m-95,0 a95,95 0 1,1 190,0 a95,95 0 1,1 -190,0"></path>
      </defs>
      <text>
        <textPath href="#lan-ring-path" textLength="592" lengthAdjust="spacing">{ring}</textPath>
      </text>
    </svg>
    <Image class="lan__logo" src={logo} alt="" width={224} height={225} loading="lazy" />
  </div>
</div>

<style>
  .lan {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    /* Pečat se meri tudi po višini, da ne prekrije napisa zgoraj */
    container-type: size;
    background:
      repeating-linear-gradient(19deg, transparent 0 70px, rgba(var(--white-rgb), 0.028) 70px 140px),
      repeating-linear-gradient(19deg, transparent 0 22px, rgba(var(--white-rgb), 0.018) 22px 24px),
      var(--lan-ink);
  }

  .lan__kicker {
    position: absolute;
    top: 22px;
    left: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
    font: 700 0.6875rem / 1 var(--font-sans);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--lan-sun);
  }

  .lan__kicker i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  .lan__seal {
    position: relative;
    /* rezerviran pas za napis zgoraj (~44 px), enako spodaj za ravnovesje */
    width: min(78%, 340px, calc(100cqh - 96px));
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin: 24px 0;
  }

  .lan__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: lan-spin 26s linear infinite;
  }

  .lan__ring text {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 17px;
    fill: var(--lan-sun);
    text-transform: uppercase;
  }

  @keyframes lan-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .lan__seal :global(.lan__logo) {
    width: 63%;
    height: auto;
    border-radius: 50%;
    background: var(--lan-cream);
  }

  /* Pavza, ko kartica ni na zaslonu (data-inview na .pcard__visual) */
  :global(.pcard__visual:not(.is-visible)) .lan__ring {
    animation-play-state: paused;
  }

  @media (max-width: 640px) {
    .lan__seal {
      width: min(66%, 240px, calc(100cqh - 72px));
      margin: 18px 0;
    }

    .lan__kicker {
      top: 14px;
      left: 16px;
    }
  }
</style>
