---
/**
 * Interne rešitve — abstraktna, »anonimizirana« nadzorna plošča:
 * okostnik vmesnika, graf, ki se riše, svetlobni pas, ki drsi čez,
 * in oznaka »Zaupno«. Brez pravih podatkov (zaupnost).
 */
import Icon from '../ui/Icon.astro';
---

<div class="intl" aria-hidden="true">
  <div class="intl__app">
    <aside class="intl__side">
      <i class="intl__logo"></i>
      <i class="is-on"></i><i></i><i></i><i></i><i></i>
    </aside>
    <div class="intl__main">
      <div class="intl__top">
        <i class="intl__search"></i>
        <i class="intl__avatar"></i>
      </div>
      <div class="intl__kpis">
        {
          [0, 1, 2].map((k) => (
            <div class="kpi" style={`--k:${k}`}>
              <i class="kpi__label" />
              <i class="kpi__value" />
              <span class="kpi__delta" />
            </div>
          ))
        }
      </div>
      <div class="intl__chart">
        <svg viewBox="0 0 300 100" preserveAspectRatio="none">
          <path class="intl__grid" d="M0 25 H300 M0 50 H300 M0 75 H300"></path>
          <path class="intl__area" d="M0 82 C 25 78, 40 64, 62 66 S 105 48, 128 52 S 170 30, 195 34 S 245 14, 270 18 L300 10 L300 100 L0 100 Z"></path>
          <path class="intl__line" pathLength="100" d="M0 82 C 25 78, 40 64, 62 66 S 105 48, 128 52 S 170 30, 195 34 S 245 14, 270 18 L300 10"></path>
        </svg>
      </div>
      <div class="intl__table">
        {
          [0, 1, 2, 3].map((r) => (
            <div class="intl__row" style={`--r:${r}`}>
              <i />
              <i />
              <i />
              <b />
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <span class="intl__scan"></span>
  <div class="intl__badge">
    <Icon name="lock" />
    <span>Zaupno · interna rešitev</span>
  </div>
</div>

<style>
  .intl {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background:
      radial-gradient(80% 70% at 85% 0%, rgba(var(--accent-rgb), 0.22), transparent 60%),
      var(--bg);
    padding: clamp(14px, 2vw, 24px);
  }

  .intl i,
  .intl b {
    display: block;
  }

  .intl__app {
    display: grid;
    grid-template-columns: 44px 1fr;
    height: 100%;
    border-radius: var(--r-sm);
    border: 1px solid var(--border-hover);
    background: var(--surface);
    overflow: hidden;
  }

  .intl__side {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 14px;
    padding: 14px 0;
    border-right: 1px solid var(--border);
    background: var(--surface-alt);
  }

  .intl__side i {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: var(--border-hover);
  }

  .intl__side .intl__logo {
    width: 20px;
    height: 20px;
    margin-bottom: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  .intl__side .is-on {
    background: var(--accent-ink);
  }

  .intl__main {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 12px;
    padding: 14px;
    min-width: 0;
  }

  .intl__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .intl__search {
    width: 46%;
    height: 22px;
    border-radius: var(--r-pill);
    background: var(--bg);
    border: 1px solid var(--border);
  }

  .intl__avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--border-hover);
  }

  .intl__kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .kpi {
    position: relative;
    display: grid;
    gap: 7px;
    padding: 10px;
    border-radius: var(--r-xs);
    border: 1px solid var(--border);
    background: var(--surface-alt);
  }

  .kpi__label {
    width: 55%;
    height: 5px;
    border-radius: 3px;
    background: var(--border-hover);
  }

  .kpi__value {
    width: 78%;
    height: 14px;
    border-radius: 3px;
    background: var(--text-tertiary);
    transform-origin: left;
    animation: kpi-pulse 3.2s var(--ease-in-out-quart) infinite;
    animation-delay: calc(var(--k) * 0.4s);
  }

  .kpi__delta {
    position: absolute;
    right: 10px;
    top: 10px;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid var(--success);
  }

  @keyframes kpi-pulse {
    0%,
    100% {
      transform: scaleX(0.62);
    }
    50% {
      transform: scaleX(1);
    }
  }

  .intl__chart {
    min-height: 0;
    border-radius: var(--r-xs);
    border: 1px solid var(--border);
    background: var(--surface-alt);
    padding: 8px;
  }

  .intl__chart svg {
    width: 100%;
    height: 100%;
  }

  .intl__grid {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .intl__area {
    fill: rgba(var(--accent-rgb), 0.18);
  }

  .intl__line {
    fill: none;
    stroke: var(--accent-ink);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 100;
    animation: chart-draw 5s var(--ease-out) infinite;
  }

  @keyframes chart-draw {
    0% {
      stroke-dashoffset: 100;
    }
    55%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  .intl__table {
    display: grid;
    gap: 6px;
  }

  .intl__row {
    display: grid;
    grid-template-columns: 2fr 1.2fr 1fr 40px;
    gap: 10px;
    align-items: center;
    padding: 6px 8px;
    border-radius: 4px;
    background: var(--surface-alt);
  }

  .intl__row i {
    height: 5px;
    border-radius: 3px;
    background: var(--border-hover);
  }

  .intl__row b {
    height: 12px;
    border-radius: var(--r-pill);
    background: rgba(var(--accent-rgb), 0.45);
  }

  .intl__scan {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 40%;
    background: linear-gradient(90deg, transparent, rgba(var(--accent-ink-rgb), 0.12), transparent);
    transform: translateX(-120%) skewX(-12deg);
    animation: scan 4.5s var(--ease-in-out-quart) infinite;
    pointer-events: none;
  }

  @keyframes scan {
    to {
      transform: translateX(320%) skewX(-12deg);
    }
  }

  .intl__badge {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: var(--r-pill);
    border: 1px solid rgba(var(--accent-ink-rgb), 0.5);
    background: rgba(var(--bg-rgb), 0.92);
    box-shadow:
      0 0 0 6px rgba(var(--bg-rgb), 0.5),
      var(--shadow-glow);
    font: 500 0.75rem / 1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    white-space: nowrap;
  }

  .intl__badge :global(.icon) {
    color: var(--accent-ink);
  }

  :global(.pcard__visual:not(.is-visible)) .intl * {
    animation-play-state: paused;
  }

  :global(.pcard__visual:not(.is-visible)) .intl__scan {
    animation-play-state: paused;
  }
</style>
