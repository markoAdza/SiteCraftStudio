---
/**
 * Kratka predstavitev (privzeta prva stran): opis, cenik, projekti, kontakt.
 * Celotna spletna podoba je na /celotna/ (src/pages/celotna.astro); izbira se
 * zapomni v localStorage (scripts/view-switch.ts) in Base.astro (viewRedirect).
 */
import '../styles/minimal.css';
import Base from '../layouts/Base.astro';
import MiniHeader from '../components/minimal/MiniHeader.astro';
import MiniIntro from '../components/minimal/MiniIntro.astro';
import MiniPricing from '../components/minimal/MiniPricing.astro';
import MiniProjects from '../components/minimal/MiniProjects.astro';
import MiniContact from '../components/minimal/MiniContact.astro';
import MiniFooter from '../components/minimal/MiniFooter.astro';
---

<Base motion={false} viewRedirect>
  <div class="mini">
    <MiniHeader />
    <main id="vsebina">
      <MiniIntro />
      <MiniPricing />
      <MiniProjects />
      <MiniContact />
    </main>
    <MiniFooter />
  </div>
</Base>

<script>
  import '../scripts/view-switch';
</script>
