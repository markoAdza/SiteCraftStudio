---
import '../styles/global.css';
import { SITE } from '../data/site';
import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Pot brez domene, npr. "/politika-zasebnosti/" */
  path?: string;
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description, path = '/', noindex = false } = Astro.props;
const canonical = new URL(path, SITE.url).toString();
const ogImage = new URL('/og.png', SITE.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: SITE.url,
  image: ogImage,
  logo: new URL('/apple-touch-icon.png', SITE.url).toString(),
  description: SITE.description,
  telephone: SITE.phone,
  email: SITE.email,
  priceRange: '49 € – 99 € / mesec',
  areaServed: { '@type': 'Country', name: 'Slovenija' },
  address: { '@type': 'PostalAddress', addressCountry: 'SI' },
  founder: { '@type': 'Person', name: SITE.owner, honorificSuffix: SITE.ownerTitle },
  knowsLanguage: ['sl', 'en'],
  makesOffer: [
    { '@type': 'Offer', name: 'BASIC — spletna prisotnost', price: '49', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'BUSINESS — spletna prisotnost + CMS', price: '69', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'PREMIUM — popolna oskrba', price: '99', priceCurrency: 'EUR' },
    { '@type': 'Offer', name: 'BUSINESS ZERO — brez začetnega vložka', price: '89', priceCurrency: 'EUR' },
  ],
};
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Site Craft Studio. — izdelava spletnih strani" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // JS je na voljo → CSS lahko pripravi začetna stanja animacij.
      // .fonts-ready sproži uvodno animacijo wordmarka (po nalaganju pisave ali najkasneje po 1,2 s).
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var done = function () { d.classList.add('fonts-ready'); };
        if (document.fonts && document.fonts.load) {
          document.fonts.load('400 1em "Instrument Serif"').then(done, done);
        } else { done(); }
        setTimeout(done, 1200);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#vsebina">Preskoči na vsebino</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
